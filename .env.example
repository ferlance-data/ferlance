# Copy to .env and restart the server.

# Required outside local development: at least 32 random characters.
# Also encrypts per-business integration keys; rotating it invalidates stored keys.
FERLANCE_SECRET_KEY=
# FERLANCE_DATA_DIR=./data
# FERLANCE_COOKIE_SECURE=true
# FERLANCE_ADMIN_EMAILS=you@example.com

# Ask Lance providers (optional). Tried in order: OpenRouter models, Groq, AgentRouter.
OPENROUTER_KEY=
OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash,openai/gpt-oss-20b
OPENROUTER_MAX_TOKENS=800
OPENROUTER_TIMEOUT_SECONDS=45
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=8
AGENTROUTER_API_KEY=
AGENTROUTER_MODELS=

# Optional: lets Lance look up market prices during a conversation (SerpAPI).
SERPAPI_KEY=
